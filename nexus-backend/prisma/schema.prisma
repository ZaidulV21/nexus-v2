generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  role         Role      @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  eventType   String
  description String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  // Business vs system distinction is now enforced at the source (PDF/system
  // events go to the Audit Log, not here). clientVisible defaults true; event
  // types that must never reach the client portal are filtered by the service
  // layer, so this column is retained for future per-event overrides.
  clientVisible Boolean @default(true)

  // Payment-scoped dedup key. The idempotency guard deduplicates events by
  // (entityType, entityId, eventType) by default, which is correct for
  // invoice lifecycle events but wrongly collapses two legitimate payments
  // made on the SAME invoice within the dedupe window. Payment-related events
  // (PAYMENT_SUCCESSFUL, PARTIAL_PAYMENT, INVOICE_PAID, PAYMENT_RECORDED,
  // RECEIPT_*, REFUND_PROCESSED) carry the paymentId (or gateway transaction
  // id) here so each payment is deduplicated independently: a webhook retry of
  // the SAME payment is still ignored, while a second payment on the same
  // invoice always produces its own timeline entry. NULL for non-payment events.
  dedupeKey String?

  @@index([entityType, entityId])
  @@index([entityType, entityId, eventType])
  @@index([entityType, entityId, eventType, dedupeKey])
  @@map("timeline_events")
}

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model NotificationEvent {
  id         String            @id @default(uuid())
  eventType  String
  entityType String?
  entityId   String?
  payload    Json
  createdAt  DateTime          @default(now())
  logs       NotificationLog[]

  // Payment-scoped dedup key, mirroring TimelineEvent.dedupeKey: payment
  // notifications (payment.recorded, payment.successful,
  // payment.receipt_available, payment.receipt_sent) carry the paymentId so
  // two legitimate payments on the same invoice each produce their own
  // notification/email while a retry of the same payment is still ignored.
  dedupeKey String?

  @@index([eventType, entityType, entityId])
  @@index([eventType, entityType, entityId, dedupeKey])
  @@map("notification_events")
}

model NotificationLog {
  id                  String            @id @default(uuid())
  notificationEventId String
  channel             String
  recipient           String
  status              String
  sentAt              DateTime?
  errorMessage        String?
  createdAt           DateTime          @default(now())
  notificationEvent   NotificationEvent @relation(fields: [notificationEventId], references: [id])

  @@map("notification_logs")
}

model InAppNotification {
  id              String    @id @default(uuid())
  recipientId     String
  recipientType   String
  title           String
  description     String
  type            String    @default("INFO")
  priority        String    @default("NORMAL")
  relatedEntity   String?
  relatedEntityId String?
  actionUrl       String?
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([recipientId, recipientType])
  @@index([recipientId, recipientType, isRead])
  @@map("in_app_notifications")
}

model StatusTransitionLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  actorUserId String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("status_transitions_log")
}

model Category {
  id               String     @id @default(uuid())
  name             String
  parentCategoryId String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryHierarchy")
  services         Service[]

  @@map("categories")
}

model Service {
  id                String                 @id @default(uuid())
  categoryId        String
  name              String
  // SEO-friendly URL segment. Backfilled from `name` on creation when the
  // admin does not supply one, and enforced unique (with a -2/-3 suffix when
  // a slug already exists). Existing public URLs stay stable because the
  // backfill algorithm matches the frontend slugify() output.
  slug              String                 @unique
  description       String?
  // Card copy shown on the public website; `description` is the long form.
  shortDescription  String?
  icon              String?
  basePrice         Decimal?               @db.Decimal(12, 2)
  requiresSiteVisit SiteVisitRequirement   @default(OPTIONAL)
  isActive          Boolean                @default(true)
  // CMS display flags + ordering.
  isFeatured        Boolean                @default(false)
  isPopular         Boolean                @default(false)
  sortOrder         Int                    @default(0)
  // Images (all optional; the website falls back to the next available one).
  imageUrl          String?
  bannerImage       String?
  thumbnail         String?
  heroImage         String?
  // SEO metadata.
  seoTitle          String?
  metaDescription   String?
  metaKeywords      String?
  ogImage           String?
  canonicalUrl      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?
  // Soft delete: the service is hidden everywhere (public site + admin list)
  // but stays attached to historical Leads/Quotations/Projects/Invoices.
  deletedAt         DateTime?
  estimatedDuration String?
  // Public detail-page content blocks (JSON arrays, mirroring SubService).
  // The website renders each section only when the array is non-empty, so a
  // service with no content yet still renders a complete, graceful page.
  features        Json     @default("[]")
  whatsIncluded   Json     @default("[]")
  // [{ title, description }]
  process         Json     @default("[]")
  // [{ question, answer }]
  faqs            Json     @default("[]")
  // [{ name, role, company, content, rating, avatar? }]
  testimonials    Json     @default("[]")
  leadServices      LeadService[]
  projectServices   ProjectService[]
  questionnaires    ServiceQuestionnaire[]
  subServices       SubService[]
  media             ServiceMedia[]
  category          Category               @relation(fields: [categoryId], references: [id])

  @@index([isActive, archivedAt, deletedAt])
  @@map("services")
}

// A Service's marketing gallery: an unlimited, ordered set of images and
// videos used purely for the website showcase. Completely independent from
// project photos and from a SubService's own gallery JSON. Each item carries
// its own alt text, caption and a featured flag (at most one featured item per
// service), so the admin can build a curated showcase without schema churn.
model ServiceMedia {
  id         String    @id @default(uuid())
  serviceId  String
  type       MediaType
  url        String
  // Optional cover/poster image, used for videos (and honoured by the public
  // lightbox so a video does not flash black before playback starts).
  posterUrl  String?
  altText    String?
  caption    String?
  sortOrder  Int       @default(0)
  isFeatured Boolean   @default(false)
  // Hide/show toggle so the admin can pull an item off the public site
  // without deleting it. Public callers only ever see isActive rows.
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, isActive, sortOrder])
  @@map("service_media")
}

// A CMS-managed Sub Service: a distinct offer under a Service, exposed at a
// public SEO URL like /services/interior-design/false-ceiling. A service can
// have unlimited sub-services. Structured content (gallery, features,
// whatsIncluded, process, faqs) is stored as JSON arrays so the admin can
// edit them without schema churn.
model SubService {
  id              String   @id @default(uuid())
  serviceId       String
  name            String
  // URL segment within the parent service: unique per service, so
  // /services/:serviceSlug/:subSlug always resolves to one row.
  slug            String
  // Card copy for the sub-service nav; `description` is the long form
  // (paragraphs are split on blank lines when rendered on the public site).
  shortDescription String?
  description     String?
  icon            String?
  heroImage       String?
  gallery         Json     @default("[]")
  features        Json     @default("[]")
  whatsIncluded   Json     @default("[]")
  // [{ title, description }]
  process         Json     @default("[]")
  // [{ question, answer }]
  faqs            Json     @default("[]")
  startingPrice   String?
  completionTime  String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  // SEO metadata.
  seoTitle        String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  canonicalUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?
  // Soft delete, mirroring Service. A sub-service is never hard-deleted.
  deletedAt       DateTime?
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  leadServices    LeadService[]

  @@unique([serviceId, slug])
  @@index([serviceId, isActive, archivedAt, deletedAt])
  @@map("sub_services")
}

model ServiceQuestionnaire {
  id           String        @id @default(uuid())
  serviceId    String
  schema       Json
  version      Int
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  leadServices LeadService[]
  service      Service       @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, version])
  @@map("service_questionnaires")
}

model Lead {
  id            String             @id @default(uuid())
  leadNumber    String             @unique
  contactName   String
  phone         String
  email         String?
  companyName   String?
  source        String             @default("WEBSITE")
  convertedAt   DateTime?
  clientId      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  client        Client?            @relation("SourceLead")
  sourceClient  Client?            @relation("ExistingClient", fields: [clientId], references: [id])
  activityNotes LeadActivityNote[]
  leadServices  LeadService[]
  projects      Project[]
  quotations    Quotation[]

  @@map("leads")
}

model LeadService {
  id                        String                @id @default(uuid())
  leadId                    String
  serviceId                 String
  // Optional Sub Service pinned at quote time (public wizard flow): the
  // client picked a specific option (e.g. Signage -> Repair), so the Lead
  // Service carries the SubService id, not a text label. SetNull keeps the
  // historical row intact if a sub-service is ever hard-deleted.
  subServiceId              String?
  status                    String                @default("NEW")
  // Timestamp when this service was converted/attached to the Lead's Client
  // (first conversion creates the Client, later conversions only attach the
  // service). NULL until the service is attached. Each service converts
  // exactly once, so a repeat "Convert to Client" only ever processes the
  // services that are qualified but not yet attached - it never duplicates a
  // Client nor re-records the same service attachment.
  convertedAt               DateTime?
  questionnaireVersionId    String?
  questionnaireAnswers      Json?
  siteVisitRequiredOverride Boolean?
  siteVisitOverrideReason   String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  lead                      Lead                  @relation(fields: [leadId], references: [id])
  questionnaireVersion      ServiceQuestionnaire? @relation(fields: [questionnaireVersionId], references: [id])
  service                   Service               @relation(fields: [serviceId], references: [id])
  subService                SubService?           @relation(fields: [subServiceId], references: [id], onDelete: SetNull)
  projectServices           ProjectService[]

  @@index([subServiceId])
  @@map("lead_services")
}

model LeadActivityNote {
  id           String   @id @default(uuid())
  leadId       String
  authorUserId String
  note         String
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id])

  @@map("lead_activity_notes")
}

model Client {
  id            String         @id @default(uuid())
  companyName   String?
  contactName   String
  phone         String
  email         String         @unique
  passwordHash  String
  sourceLeadId  String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  lastLoginAt   DateTime?
  clientNumber  String         @unique
  gstin         String?
  sourceLead    Lead           @relation("SourceLead", fields: [sourceLeadId], references: [id])
  existingLeads Lead[]         @relation("ExistingClient")
  conversations Conversation[]
  documents     Document[]
  invoices      Invoice[]
  payments      Payment[]
  projects      Project[]
  quotations    Quotation[]

  @@map("clients")
}

model Quotation {
  id                 String             @id @default(uuid())
  quotationNumber    String             @unique
  leadId             String
  clientId           String
  status             QuotationStatus    @default(DRAFT)
  activeVersionId    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  pdfUrl             String?
  pdfGeneratedAt     DateTime?          @db.Timestamptz(6)
  validUntil         DateTime?
  notes              String?
  termsAndConditions String?
  paymentTerms       String?
  versions           QuotationVersion[]
  client             Client             @relation(fields: [clientId], references: [id])
  lead               Lead               @relation(fields: [leadId], references: [id])

  @@map("quotations")
}

model QuotationVersion {
  id              String              @id @default(uuid())
  quotationId     String
  versionNumber   Int
  isActive        Boolean             @default(true)
  subtotal        Decimal             @db.Decimal(12, 2)
  discount        Decimal             @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal             @default(0) @db.Decimal(12, 2)
  transportation  Decimal             @default(0) @db.Decimal(12, 2)
  installation    Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal             @db.Decimal(12, 2)
  createdByUserId String
  createdAt       DateTime            @default(now())
  projectServices ProjectService[]
  approvals       QuotationApproval[]
  items           QuotationItem[]
  quotation       Quotation           @relation(fields: [quotationId], references: [id])

  @@unique([quotationId, versionNumber])
  @@map("quotation_versions")
}

model QuotationItem {
  id                 String           @id @default(uuid())
  quotationVersionId String
  serviceId          String
  description        String
  quantity           Decimal          @db.Decimal(10, 2)
  // Measurement unit for the line (Nos, Sq Ft, Meter, Job, ...). "None" is the
  // default so existing quotations without a unit remain valid.
  unit               String           @default("None")
  unitPrice          Decimal          @db.Decimal(12, 2)
  taxRate            Decimal          @db.Decimal(5, 2)
  taxAmount          Decimal          @db.Decimal(12, 2)
  lineTotal          Decimal          @db.Decimal(12, 2)
  serviceName        String?
  hsnSacCode         String?
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id])

  @@map("quotation_items")
}

model QuotationApproval {
  id                 String           @id @default(uuid())
  quotationVersionId String
  approvedByUserId   String
  approvalMethod     ApprovalMethod
  approvedAt         DateTime         @default(now())
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id])

  @@map("quotation_approvals")
}

model Project {
  id              String           @id @default(uuid())
  projectNumber   String           @unique
  leadId          String
  clientId        String
  // Human-friendly project name shown on the public portfolio. When empty the
  // website falls back to the client's company/contact name.
  title           String?
  // Set once by the explicit "mark complete" action. This is the single
  // moment a Project "becomes Completed" for the public portfolio: completed
  // projects (and their completion media) appear automatically on the site.
  completedAt     DateTime?
  completedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  conversations   Conversation[]
  documents       Document[]
  invoices        Invoice[]
  payments        Payment[]
  projectServices ProjectService[]
  media           ProjectMedia[]
  client          Client           @relation(fields: [clientId], references: [id])
  lead            Lead             @relation(fields: [leadId], references: [id])

  @@map("projects")
}

// Completion media for a finished Project (the public Portfolio gallery). One
// project can hold unlimited completion images, videos and documents. This is
// completely independent from the Service marketing gallery (ServiceMedia) and
// from a SubService's own gallery JSON. Items are hard-deleted (lightweight
// records), and public callers only ever see isActive rows.
model ProjectMedia {
  id         String           @id @default(uuid())
  projectId  String
  type       ProjectMediaType
  url        String
  // Optional cover/poster image, used for videos (and documents that carry a
  // preview) so the portfolio does not flash blank before media loads.
  posterUrl  String?
  // Short label; for documents this is the display name.
  title      String?
  altText    String?
  caption    String?
  // Document metadata (kept for IMAGE/VIDEO uploads too so the admin UI can
  // render a sensible filename).
  fileName   String?
  mimeType   String?
  fileSize   Int?
  sortOrder  Int              @default(0)
  isFeatured Boolean          @default(false)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, isActive, sortOrder])
  @@map("project_media")
}

model ProjectService {
  id                         String            @id @default(uuid())
  projectId                  String
  serviceId                  String
  leadServiceId              String?
  status                     String            @default("PROJECT CREATED")
  assignedQuotationVersionId String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  assignedQuotationVersion   QuotationVersion? @relation(fields: [assignedQuotationVersionId], references: [id])
  leadService                LeadService?      @relation(fields: [leadServiceId], references: [id])
  project                    Project           @relation(fields: [projectId], references: [id])
  service                    Service           @relation(fields: [serviceId], references: [id])

  @@map("project_services")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  projectId       String
  clientId        String
  label           String
  status          InvoiceStatus @default(DRAFT)
  cancelReason    String?
  subtotal        Decimal       @db.Decimal(12, 2)
  gstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  issuedAt        DateTime      @default(now())
  createdByUserId String
  pdfUrl          String?
  pdfGeneratedAt  DateTime?     @db.Timestamptz(6)
  items           InvoiceItem[]
  client          Client        @relation(fields: [clientId], references: [id])
  project         Project       @relation(fields: [projectId], references: [id])
  payments        Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  // Measurement unit for the line (Nos, PCS, Sq Ft, Job, ...). "None" is the
  // default so existing invoice lines without a unit remain valid.
  unit        String  @default("None")
  unitPrice   Decimal @db.Decimal(12, 2)
  hsnSacCode  String
  taxRate     Decimal @db.Decimal(5, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid())
  invoiceId            String
  clientId             String
  projectId            String
  amount               Decimal       @db.Decimal(12, 2)
  method               String
  status               PaymentStatus @default(SUCCESS)
  referenceNote        String?
  recordedByUserId     String
  paidAt               DateTime      @default(now())
  transactionReference String?
  gatewayMetadata      Json?
  gatewayPaidAt        DateTime?
  gatewayPaymentUrl    String?
  gatewayStatus        String?
  gatewayTransactionId String?
  receiptGeneratedAt   DateTime?
  receiptUrl           String?
  receiptSentAt        DateTime?
  invoice              Invoice       @relation(fields: [invoiceId], references: [id])
  client               Client        @relation(fields: [clientId], references: [id])
  project              Project       @relation(fields: [projectId], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  // Online payments must be idempotent at the database level: one Razorpay
  // transaction (and one manual transaction reference) can never produce more
  // than one Payment record, even under concurrent verification requests.
  // Both columns are nullable - the UNIQUE indexes allow multiple NULLs, so
  // offline payments without a reference remain unaffected.
  @@unique([gatewayTransactionId])
  @@unique([transactionReference])
  @@map("payments")
}

model InvoiceNumberSequence {
  id            String @id @default(uuid())
  financialYear String @unique
  lastNumber    Int    @default(0)

  @@map("invoice_number_sequences")
}

model Document {
  id               String    @id @default(uuid())
  entityType       String
  entityId         String
  documentType     String
  fileName         String
  fileUrl          String
  fileSize         Int
  mimeType         String
  uploadedByUserId String
  clientId         String?
  projectRefId     String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  client           Client?   @relation(fields: [clientId], references: [id])
  projectRef       Project?  @relation(fields: [projectRefId], references: [id])

  @@index([entityType, entityId])
  @@map("documents")
}

model Conversation {
  id        String    @id @default(uuid())
  clientId  String
  projectId String?
  createdAt DateTime  @default(now())
  client    Client    @relation(fields: [clientId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderType     String
  senderUserId   String?
  senderClientId String?
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model CompanySetting {
  id                  String   @id @default("singleton")
  companyName         String?
  legalBusinessName   String?
  logoUrl             String?
  faviconUrl          String?
  gstNumber           String?
  panNumber           String?
  cin                 String?
  email               String?
  phone               String?
  whatsappNumber      String?
  website             String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  country             String?
  pincode             String?
  currency            String?  @default("INR")
  currencySymbol      String?  @default("₹")
  timezone            String?  @default("Asia/Kolkata")
  dateFormat          String?  @default("dd/MM/yyyy")
  invoicePrefix       String?  @default("INV")
  quotationPrefix     String?  @default("QUO")
  projectPrefix       String?  @default("PRJ")
  clientPrefix        String?  @default("CLI")
  leadPrefix          String?  @default("LD")
  defaultGstPercent   Decimal? @default(18) @db.Decimal(5, 2)
  defaultPaymentTerms String?
  companySignatureUrl String?
  companyStampUrl     String?
  bankName            String?
  accountHolder       String?
  accountNumber       String?
  ifsc                String?
  branch              String?
  upiId               String?
  qrCodeUrl           String?
  senderName          String?
  replyToEmail        String?
  supportEmail        String?
  facebook            String?
  instagram           String?
  linkedin            String?
  twitter             String?
  youtube             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_settings")
}

model OtpVerification {
  id         String    @id @default(uuid())
  email      String    @unique
  hashedOtp  String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@map("otp_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_reset_tokens")
